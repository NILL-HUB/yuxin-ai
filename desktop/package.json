{
  "name": "yujianwo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "钰见我 Windows 桌面端：Web UI + 本地 Worker（OS/回收站/浏览器/计算机/唤醒词）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:ui": "npm --prefix ../ui run build:desktop",
    "stage:cua": "node scripts/stage-cua-driver.js",
    "pack": "npm run stage:cua && electron-builder --dir",
    "dist": "npm run build:ui && npm run stage:cua && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ai.yujianwo.desktop",
    "productName": "钰见我",
    "directories": {
      "output": "dist-nsis"
    },
    "files": [
      "main.js",
      "preload.js",
      "server-config.js",
      "credential-store.js",
      "device-registry.js",
      "cua-driver-host.js",
      "bridge.js",
      "tray.js",
      "updater.js",
      "window-state.js"
    ],
    "extraResources": [
      {
        "from": "../ui/dist-desktop",
        "to": "ui-dist"
      },
      {
        "from": "../api/scripts/pyinstaller/dist/yujianwo-worker.exe",
        "to": "yujianwo-worker/yujianwo-worker.exe"
      },
      {
        "from": "vendor/cua-driver",
        "to": "cua-driver"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://openllm.cloud/desktop-updates"
    }
  }
}
