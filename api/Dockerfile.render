# 渲染 worker 专用镜像
#
# 设计依据：docs/superpowers/specs/2026-09-16-video-production-p4-design.md §3.2
#
# 为什么必须单独建镜像（三条均为实测结论）：
#   1. api/Dockerfile 装的 nodejs/npm 来自 Debian bookworm 仓库 => Node 18，
#      低于 HyperFrames 硬要求的 Node >= 22；且无 chromium、无 ffmpeg/ffprobe。
#   2. Dockerfile.worker 有 playwright/chromium，但无 node、无 ffmpeg，
#      且它只装 requirements-workers.txt，不含应用依赖，跑不了本项目代码。
#   3. 两个镜像都不能直接复用，故本镜像在 api 镜像之上补齐三件依赖。
#
# 关于 Node 版本与发行版（易踩坑，实测确认）：
#   * HyperFrames 的要求是 **Node >= 22**（下限，不是必须正好 22）。本机 host
#     node v24.9.0 已实测跑通 hyperframes 0.8.42 并渲染出真 MP4，故用 24 更好。
#   * **必须用 glibc 版（bookworm/trixie），不能用 alpine**：alpine 的 node 二进制
#     链接的是 `libc.musl-x86_64.so.1`，而本 api 镜像是 Debian/glibc，
#     把 alpine 的 node 拷进来根本起不来（缺 ld-musl）。
#     实测 `ldd /usr/local/bin/node`（alpine）=> /lib/ld-musl-x86_64.so.1。
#   * 因此基准镜像用 `node:<ver>-bookworm-slim`，与 api 镜像同 libc 系。
#
# 用法（在部署编排里）：
#   MODE=celery CELERY_QUEUES=render \
#   HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium \
#   HYPERFRAMES_FFMPEG_PATH=/usr/bin/ffmpeg \
#   HYPERFRAMES_FFPROBE_PATH=/usr/bin/ffprobe
#
# 注意：`render` 队列必须由本镜像的 worker 以 `-Q render` 独占消费，
# 且上述三个 HYPERFRAMES_* 变量只应配在本 worker 上（勿配到主业务 worker）。

ARG API_IMAGE=llmops-api:0.1.0
ARG NODE_IMAGE=node:24-bookworm-slim

# ---- 阶段一：取官方 Node（glibc 版），避免任何网络下载 ----
# 直接复用本地已有的 node 镜像，保证版本与上游一致且构建不依赖外网。
# 注意用 bookworm-slim 而非 alpine：见上文 libc 说明。
FROM ${NODE_IMAGE} AS node

# ---- 阶段二：渲染运行时 ----
FROM ${API_IMAGE}

SHELL ["/bin/bash", "-c"]

# 1) 换国内 apt 源：deb.debian.org（Fastly CDN）在本网环境会间歇返回 502，
#    导致 apt 下载中途失败（实测：284 个包成功、2 个 502 后整体 exit 100）。
#    同时兼容新版 deb822（debian.sources）与旧版 sources.list 两种格式。
RUN set -eux; \
    for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
        if [ -f "$f" ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g' "$f"; fi; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        chromium \
        ca-certificates curl unzip xz-utils \
        libgbm1 libnss3 libatk-bridge2.0-0 libdrm2 libxcomposite1 \
        libxdamage1 libxrandr2 libcups2 libasound2 libpangocairo-1.0-0 \
        libxshmfence1 libgtk-3-0 \
        fonts-liberation fonts-noto-cjk fonts-dejavu-core fontconfig; \
    rm -rf /var/lib/apt/lists/*; \
    fc-cache -fv; \
    ffmpeg -version | head -1; ffprobe -version | head -1; chromium --version

# 2) 用官方 Node 22 覆盖 Debian 自带的 Node 18（/usr/local/bin 优先于 /usr/bin）。
#    保留 Debian 的 nodejs/npm 包不动——api 镜像的 MCP stdio 能力依赖它们存在。
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN set -eux; \
    ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx; \
    node --version; npm --version; \
    node -e 'const v=process.versions.node.split(".").map(Number); if(v[0]<22){console.error("Node < 22，HyperFrames 无法运行"); process.exit(1)}'

# 3) 钉死 HyperFrames CLI 版本，保证同一 composition 重复渲染结果一致。
#    走国内 npm 镜像，避开海外源抖动。
ARG HYPERFRAMES_VERSION=0.8.42
RUN set -eux; \
    npm config set registry https://registry.npmmirror.com; \
    npm install -g hyperframes@${HYPERFRAMES_VERSION}; \
    hyperframes --version

# 渲染产物与中间文件默认落在工作目录，交给挂载卷
WORKDIR /app/api
