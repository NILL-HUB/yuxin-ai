# 渲染 worker 专用镜像
#
# 设计依据：docs/superpowers/specs/2026-09-16-video-production-p4-design.md §3.2
#
# 为什么必须单独建镜像（三条均为实测结论）：
#   1. api/Dockerfile 装的 nodejs/npm 来自 Debian bookworm 仓库 => Node 18，
#      低于 HyperFrames 硬要求的 Node >= 22；且无 chromium、无 ffmpeg/ffprobe。
#   2. Dockerfile.worker 有 playwright/chromium，但无 node、无 ffmpeg，
#      且它只装 requirements-workers.txt，不含应用依赖，跑不了本项目代码。
#   3. 两个镜像都不能直接复用，故本镜像在 api 镜像之上补齐三件依赖。
#
# 关于 Node 版本与发行版（易踩坑，实测确认）：
#   * HyperFrames 的要求是 **Node >= 22**（下限，不是必须正好 22）。本机 host
#     node v24.9.0 已实测跑通 hyperframes 0.8.42 并渲染出真 MP4，故用 24 更好。
#   * **必须用 glibc 版（bookworm/trixie），不能用 alpine**：alpine 的 node 二进制
#     链接的是 `libc.musl-x86_64.so.1`，而本 api 镜像是 Debian/glibc，
#     把 alpine 的 node 拷进来根本起不来（缺 ld-musl）。
#     实测 `ldd /usr/local/bin/node`（alpine）=> /lib/ld-musl-x86_64.so.1。
#   * 因此基准镜像用 `node:<ver>-bookworm-slim`，与 api 镜像同 libc 系。
#
# 用法（在部署编排里）：
#   MODE=celery CELERY_QUEUES=render \
#   HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium \
#   HYPERFRAMES_FFMPEG_PATH=/usr/bin/ffmpeg \
#   HYPERFRAMES_FFPROBE_PATH=/usr/bin/ffprobe
#
# 注意：`render` 队列必须由本镜像的 worker 以 `-Q render` 独占消费，
# 且上述三个 HYPERFRAMES_* 变量只应配在本 worker 上（勿配到主业务 worker）。

ARG API_IMAGE=llmops-api:0.1.0
ARG NODE_IMAGE=node:24-bookworm-slim

# ---- 阶段一：取官方 Node（glibc 版），避免任何网络下载 ----
# 直接复用本地已有的 node 镜像，保证版本与上游一致且构建不依赖外网。
# 注意用 bookworm-slim 而非 alpine：见上文 libc 说明。
FROM ${NODE_IMAGE} AS node

# ---- 阶段二：渲染运行时 ----
FROM ${API_IMAGE}

SHELL ["/bin/bash", "-c"]

# 1) 换国内 apt 源并加大重试：本网络环境对大文件持续下载不稳定，
#    deb.debian.org（Fastly）会间歇 502，aliyun 镜像对 chromium / fonts-noto-cjk /
#    libllvm15 这类大包会中断连接（实测 "Connection failed"）。故：
#    - 换 aliyun 源（避开 Fastly 502）；
#    - 打开 apt 重试与超时放宽；
#    - **外层循环重试整条 install**：单次 apt-get install 里任何一个大文件超时都会让
#      整个事务失败，但已下好的 .deb 会留在缓存里、下一轮直接命中。
#      故失败后重跑就能「逐轮啃下」大包，这是本网络环境下最有效的办法。
RUN set -eux; \
    printf 'Acquire::Retries "10";\nAcquire::http::Timeout "240";\nAcquire::https::Timeout "240";\n' \
        > /etc/apt/apt.conf.d/99-hf-retries; \
    for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
        if [ -f "$f" ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g' "$f"; fi; \
    done; \
    apt-get update; \
    ok=0; \
    for attempt in 1 2 3 4 5 6 7 8; do \
        echo "=== apt install attempt $attempt ==="; \
        if apt-get install -y --no-install-recommends \
            ffmpeg \
            chromium \
            ca-certificates curl unzip xz-utils \
            libgbm1 libnss3 libatk-bridge2.0-0 libdrm2 libxcomposite1 \
            libxdamage1 libxrandr2 libcups2 libasound2 libpangocairo-1.0-0 \
            libxshmfence1 libgtk-3-0 \
            fonts-liberation fonts-noto-cjk fonts-dejavu-core fontconfig; then \
            ok=1; break; \
        fi; \
        echo "attempt $attempt failed, retrying after cache-preserving sleep"; \
        sleep 5; \
    done; \
    test "$ok" = "1" || { echo "apt install failed after retries"; exit 1; }; \
    rm -rf /var/lib/apt/lists/*; \
    fc-cache -fv; \
    ffmpeg -version | head -1; ffprobe -version | head -1; chromium --version

# 2) 用官方 Node 22 覆盖 Debian 自带的 Node 18（/usr/local/bin 优先于 /usr/bin）。
#    保留 Debian 的 nodejs/npm 包不动——api 镜像的 MCP stdio 能力依赖它们存在。
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN set -eux; \
    ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx; \
    node --version; npm --version; \
    node -e 'const v=process.versions.node.split(".").map(Number); if(v[0]<22){console.error("Node < 22，HyperFrames 无法运行"); process.exit(1)}'

# 3) 安装 HyperFrames CLI（钉死版本，保证同一 composition 重复渲染结果一致）。
#
# ⚠️ 必须用 **本地安装**（装进固定目录），**不要用 `npm install -g`**：
#    实测在容器内，全局安装（/usr/local/lib/node_modules/hyperframes）下渲染会失败于
#      [HyperframeRuntimeLoader] Missing manifest ...
#    而同样的镜像、同样的 composition，改用本地安装（node_modules/hyperframes）即可
#    完整渲染成功（120/120 帧 → MP4）。
#    原因：CLI 的 renderSetupWorker 子进程依赖打包 chunk 的相对布局推导 manifest 路径，
#    全局安装的扁平化路径布局与之不符。本地安装保留了预期目录结构，故可用。
#
#    注意这与「宿主机上全局安装能跑通」不矛盾——差异在 npm 布局 + 容器内 cwd 组合。
ARG HYPERFRAMES_VERSION=0.8.42
ENV HYPERFRAMES_HOME=/opt/hyperframes
RUN set -eux; \
    npm config set registry https://registry.npmmirror.com; \
    mkdir -p ${HYPERFRAMES_HOME}; \
    cd ${HYPERFRAMES_HOME}; \
    npm init -y > /dev/null; \
    npm install hyperframes@${HYPERFRAMES_VERSION} --no-audit --no-fund; \
    ${HYPERFRAMES_HOME}/node_modules/.bin/hyperframes --version

# 渲染产物与中间文件默认落在工作目录，交给挂载卷
WORKDIR /app/api
