# ==================== Flask 基础配置 ====================
FLASK_DEBUG=0
FLASK_ENV=production

# ==================== WTF 配置 ====================
WTF_CSRF_ENABLED=False

# ==================== 服务配置 ====================
SERVICE_IP=your-server-ip
SERVICE_API_PREFIX=https://your-domain.com/api

# ==================== 前端构建配置 ====================
# Docker Compose 构建 UI 时会直接从 api/.env 读取该值,不再需要额外的 .env 文件
VITE_API_PREFIX=http://127.0.0.1:5001

# ==================== JWT 加密密钥 ====================
# 生成方法: openssl rand -hex 32
JWT_SECRET_KEY=your-random-secret-key-here-change-this

# ==================== SQLAlchemy 数据库配置 ====================
# 本地开发使用 localhost，Docker 环境会自动覆盖为 llmops-db
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your-password@localhost:5432/llmops?client_encoding=utf8
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_TIMEOUT=10
SQLALCHEMY_POOL_PRE_PING=True
SQLALCHEMY_CONNECT_TIMEOUT=5
SQLALCHEMY_STATEMENT_TIMEOUT_MS=30000
SQLALCHEMY_ECHO=False

# Docker 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=llmops

# ==================== 辅助 Agent 智能体应用 ID ====================
ASSISTANT_AGENT_ID=your-assistant-agent-id
# 首页助手可用的 MCP 绑定（JSON 数组，默认空）
ASSISTANT_MCP_BINDINGS=[]

# ==================== 多模态图片请求策略 ====================
# strict: 纯文本模型收到图片直接报错
# auto_upgrade: 若配置了视觉兜底模型，则自动切换到对应模型
IMAGE_REQUEST_POLICY=strict
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_MODEL=

# ==================== Redis 配置 ====================
# 本地开发使用 localhost，Docker 环境会自动覆盖为 llmops-redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0
REDIS_USE_SSL=False
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30

# ==================== Celery 配置 ====================
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=False
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# ==================== LLM API Keys ====================
# 注意：LLM 模型/provider/key 必须通过 admin 后台 + 数据库统一管理，
# 以下仅保留部分工具专用 provider 的环境变量配置。

# 月之暗面
MOONSHOT_API_KEY=sk-your-moonshot-key-here

# OpenAI 兼容代理请求超时（秒）
LLM_REQUEST_TIMEOUT=120

# Atlas Cloud
ATLASCLOUD_API_KEY=your-atlascloud-key-here
ATLASCLOUD_API_BASE=https://api.atlascloud.ai/v1

# Grok
GROK_API_KEY=sk-your-grok-key-here
GROK_API_BASE=https://api.x.ai/v1

# 百度千帆
qianfan_ak=your-qianfan-ak-here
qianfan_sk=your-qianfan-sk-here

# 文心一言
WENXIN_YIYAN_API_KEY=your-wenxin-key-here

# ==================== LangSmith 配置 ====================
# 链路追踪是系统应有的功能。当配置有效 API key 时自动启用 tracing。
# 当 API key 为空或占位符（your-*-here）时，应用启动时自动降级为关闭，
# 避免每次请求产生 403 Forbidden WARNING 刷屏（app/http/app.py 中的
# _graceful_disable_invalid_langsmith_tracing 实现 graceful 降级）。
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=YourProjectName

# ==================== 第三方服务 API Keys ====================
# Pinecone
PINECONE_API_KEY=your-pinecone-key-here

# HuggingFace
HUGGINGFACEHUB_API_TOKEN=your-huggingface-token-here
TRANSFORMERS_OFFLINE=0

# Cohere
COHERE_API_KEY=your-cohere-key-here

# 高德地图
GAODE_API_KEY=your-gaode-key-here

# 谷歌 Serper 搜索
SERPER_API_KEY=your-serper-key-here

# SerpAPI
SERPAPI_API_KEY=your-serpapi-key-here

# Tavily AI
TAVILY_API_KEY=your-tavily-key-here

# ==================== 插件 API Keys ====================
# Stability AI (图像生成)
STABILITY_API_KEY=sk-your-stability-key-here

# OpenWeatherMap (天气)
OPENWEATHERMAP_API_KEY=your-openweathermap-key-here

# News API (新闻)
NEWSAPI_API_KEY=your-newsapi-key-here

# Wolfram Alpha (计算)
WOLFRAM_ALPHA_APPID=your-wolfram-appid-here

# GitHub (代码)
GITHUB_ACCESS_TOKEN=ghp_your-github-token-here

# ==================== OAuth 配置 ====================
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/authorize/github

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/authorize/google

# ==================== 文件存储后端配置 ====================
# 存储后端类型：local(本地存储,默认/开发) | cos(腾讯云COS) | oss(阿里云OSS)
# 详见 docs/prd/architecture-design.md 第 17 节「文件存储与对象存储架构」
STORAGE_BACKEND=local

# ---------- 本地文件存储配置（STORAGE_BACKEND=local 时生效）----------
# 文件存储根目录（相对于容器工作目录 /app/api）
LOCAL_STORAGE_ROOT=storage/uploads
# 访问基础 URL（默认为空，使用相对路径 /storage/local/{key}，由浏览器拼接当前域名）
# 生产环境可配置独立 CDN 域名，如 https://cdn.example.com
LOCAL_STORAGE_BASE_URL=

# ---------- 腾讯云 COS 配置（STORAGE_BACKEND=cos 时生效）----------
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-beijing
COS_SCHEME=https
COS_BUCKET=your-bucket-name
COS_DOMAIN=https://your-bucket-name.cos.ap-beijing.myqcloud.com
COS_TIMEOUT_SECONDS=10
COS_SDK_RETRY=1
COS_UPLOAD_MAX_ATTEMPTS=3
COS_AUTO_SWITCH_DOMAIN_ON_RETRY=True
COS_ENABLE_OLD_DOMAIN=True
COS_ENABLE_INTERNAL_DOMAIN=False

# ---------- 阿里云 OSS 配置（STORAGE_BACKEND=oss 时生效）----------
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
# OSS 端点（如 oss-cn-beijing.aliyuncs.com）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your-bucket-name
# 自定义访问域名/CDN 域名（可选，留空则自动拼接 https://{bucket}.{endpoint}）
OSS_DOMAIN=

# 腾讯云 Serverless 云函数
SANDBOX_URL=https://your-scf-url.tencentscf.com

# ==================== 深度思考沙箱配置 ====================
# lite 档位建议对应 2 CPU / 2048 MiB 的自定义模板
SANDBOX_PROFILE=lite
SANDBOX_TEMPLATE_ALIAS=llmops-code-interpreter-lite
SANDBOX_FALLBACK_TEMPLATE_ALIAS=code-interpreter-v1
AGENT_LISTEN_TIMEOUT_SECONDS=1800
SANDBOX_TIMEOUT_SECONDS=1800
SANDBOX_EXECUTE_TIMEOUT_SECONDS=600

# ==================== 邮件服务配置 ====================
# QQ 邮箱 SMTP 配置（用于发送验证码）
MAIL_SERVER=smtp.qq.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=your-email@qq.com

# ==================== Nginx 配置 ====================
NGINX_DOMAIN_NAME=localhost
NGINX_SSL_CERT_FILE=server.crt
NGINX_SSL_KEY_FILE=server.key
NGINX_ENABLE_HTTPS=false

# ==================== Docker 端口配置 ====================
UI_PORT=3000
API_PORT=5001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
POSTGRES_PORT=5432

# ==================== 工具凭证加密密钥 ====================
# 用于加密 api_tool.headers / mcp.headers / mcp.env 等敏感字段（Fernet AES-256）
# 复用 MODEL_KEY_ENCRYPTION_KEY 避免引入新密钥；未配置时生成临时密钥并 WARNING
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_KEY_ENCRYPTION_KEY=

# ==================== 记忆系统配置（架构文档 v5.0 第 16 章） ====================
# Neo4j（TKG 时序知识图谱）
NEO4J_USER=neo4j
NEO4J_PASSWORD=openagent123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# MinIO（记忆系统对象存储）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== 镜像版本 ====================
IMAGE_VERSION=0.1.0

# VITE_TITLE 浏览器网站标题
VITE_TITLE=OpenAgent

# OAuth 允许的来源域名（用于动态回调地址）
OAUTH_ALLOWED_ORIGINS=https://openllm.cloud

# CORS_ALLOW_ORIGINS
CORS_ALLOW_ORIGINS=https://openllm.cloud

# 超级管理员初始化配置（首次启动时自动创建超级管理员账号）
ADMIN_BOOTSTRAP_ENABLED=1
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Root123456
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_NAME=超级管理员
