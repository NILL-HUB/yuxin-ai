# Docker Compose 变量模板：复制为 docker/.env（该文件已 gitignore）后按需填写。
# 仅列出「无安全默认、生产必须显式配置」的变量；其余变量在 compose 中均有默认值。

# ============ 高风险 worker 鉴权 token（必填，否则对应 worker 拒绝启动）============
# 生成方式（任选其一）：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# 浏览器自动化 worker：服务端 headless Chromium（Web 端「内部浏览器」回退通道）
# 未配置 => worker fail-fast 退出、api 侧 browser_action 返回「未配置」（fail closed）
BROWSER_AUTOMATION_TOKEN=

# 电脑控制 worker：容器内 xvfb 虚拟桌面（默认不启动，需 `--profile local-workers`）
COMPUTER_CONTROL_TOKEN=
